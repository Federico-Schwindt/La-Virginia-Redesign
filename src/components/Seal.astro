---
// Sello circular giratorio "Desde 1915" — motivo de etiqueta clásica
interface Props { class?: string; text?: string }
const { class: cls, text = 'CAFÉS LA VIRGINIA · ROSARIO · DESDE 1915 · SABORES QUE RECONFORTAN · ' } = Astro.props;
const id = `seal-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={['seal', cls]} aria-hidden="true">
  <svg viewBox="0 0 200 200">
    <defs><path id={id} d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
    <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="1" opacity=".5" />
    <circle cx="100" cy="100" r="60" fill="none" stroke="currentColor" stroke-width="1" opacity=".5" />
    <g class="seal__ring"><text font-size="12.4" letter-spacing="2.6" fill="currentColor"><textPath href={`#${id}`}>{text}</textPath></text></g>
    <g transform="translate(100 104)" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M-22 10a22 22 0 0 1 44 0" />
      <path d="M0-26v8M-17-19l5 5M17-19l-5 5M-27-4h7M27-4h-7" />
    </g>
    <text x="100" y="140" text-anchor="middle" font-size="15" font-style="italic" fill="currentColor" font-family="var(--serif)">1915</text>
  </svg>
</div>
<style>
  .seal { width: 150px; aspect-ratio: 1; color: var(--oro); }
  .seal svg { width: 100%; height: 100%; overflow: visible; font-family: var(--sans); font-weight: 600; }
  .seal__ring { transform-origin: 100px 100px; animation: spin 38s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
