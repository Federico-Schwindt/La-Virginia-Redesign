</Base>

<script>
  import { animate, inView } from 'motion';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Pestañas simples (antes/después y métricas)
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((g) => {
    const btns = g.querySelectorAll<HTMLButtonElement>('[data-tab]');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        g.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
          p.hidden = p.dataset.panel !== b.dataset.tab;
          if (!p.hidden) [p, ...p.querySelectorAll('[data-rv]')].forEach((el) => el.classList.add('in'));
        });
      }),
    );
  });

  // Comparador antes/después
  document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((c) => {
    const r = c.querySelector<HTMLInputElement>('.cmp__range')!;
    const set = (v: number) => c.style.setProperty('--x', `${v}%`);
    r.addEventListener('input', () => set(+r.value));
    if (reduced) return;
    // Pista de interacción: el divisor se asoma la primera vez que aparece
    let touched = false;
    r.addEventListener('pointerdown', () => (touched = true), { once: true });
    inView(c, () => {
      if (touched) return;
      animate(82, 50, { duration: 1.6, delay: 0.5, ease: [0.2, 0.75, 0.15, 1], onUpdate: (v) => { if (!touched) { set(v); r.value = String(v); } } });
    }, { amount: 0.5 });
  });
</script>

