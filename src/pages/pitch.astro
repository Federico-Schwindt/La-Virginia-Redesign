---
/**
 * Propuesta para La Virginia: dossier editorial con antes/después, métricas medidas,
 * decisiones de diseño, integración y contacto. Mismo lenguaje del sitio (arco, filete dorado, numerales romanos).
 */
import fs from 'node:fs';
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';
import Seal from '../components/Seal.astro';
import M from '../data/pitch-metrics.json';
import { url, products, tes, cafes, AUTHOR } from '../lib/site';

const siteUrl = new URL(url('/'), Astro.site).href;
const qr = await QRCode.toString(siteUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#0a2e73', light: '#0000' } });

type Metric = (typeof M)['home']['old'];
type Row = { k: string; hint: string; old: number; neu: number; unit: string; dec: number; up?: boolean; max?: number };
const rows = (o: Metric, n: Metric): Row[] => [
  { k: 'Rendimiento', hint: 'Puntaje de Lighthouse, de 0 a 100', old: o.perf, neu: n.perf, unit: '', dec: 0, up: true, max: 100 },
  { k: 'Contenido principal visible', hint: 'LCP: cuándo aparece lo más importante', old: o.lcp / 1000, neu: n.lcp / 1000, unit: ' s', dec: 1 },
  { k: 'Tiempo bloqueado', hint: 'TBT: la página no responde al toque', old: o.tbt, neu: n.tbt, unit: ' ms', dec: 0 },
  { k: 'Peso total', hint: 'Todo lo que descarga el celular', old: o.bytes / 1e6, neu: n.bytes / 1e6, unit: ' MB', dec: 2 },
  { k: 'Solicitudes', hint: 'Archivos que pide la página', old: o.reqs, neu: n.reqs, unit: '', dec: 0 },
  { k: 'JavaScript', hint: 'Código que el teléfono tiene que ejecutar', old: o.js / 1000, neu: n.js / 1000, unit: ' KB', dec: 0 },
  { k: 'Accesibilidad', hint: 'Contraste, títulos, etiquetas, foco', old: o.a11y, neu: n.a11y, unit: '', dec: 0, up: true, max: 100 },
  { k: 'Buenas prácticas', hint: 'Seguridad, consola, imágenes', old: o.bp, neu: n.bp, unit: '', dec: 0, up: true, max: 100 },
];
const fmt = (v: number, d = 0) => v.toLocaleString('es-AR', { minimumFractionDigits: d, maximumFractionDigits: d });
const round = (v: number, d: number) => Math.round(v * 10 ** d) / 10 ** d;
const change = (r: Row) => {
  if (r.up) return `+${fmt(r.neu - r.old)} pts`;
  const pct = Math.round((1 - r.neu / r.old) * 100);
  return `−${fmt(pct)} %`;
};
const pages = [
  { id: 'home', label: 'Inicio', rows: rows(M.home.old, M.home.new), o: M.home.old, n: M.home.new },
  { id: 'pdp', label: 'Ficha de producto', rows: rows(M.pdp.old, M.pdp.new), o: M.pdp.old, n: M.pdp.new },
];
const measured = new Date(M.measured + 'T12:00:00').toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
const speedup = (M.home.old.lcp / M.home.new.lcp).toLocaleString('es-AR', { maximumFractionDigits: 1 });

const chapters = [
  ['I', 'Carta', '#carta'],
  ['II', 'Antes y después', '#antes-despues'],
  ['III', 'Dónde hay margen', '#margen'],
  ['IV', 'Los números', '#numeros'],
  ['V', 'Ideas de diseño', '#ideas'],
  ['VI', 'En el celular', '#movil'],
  ['VII', 'Cómo se implementa', '#integracion'],
  ['VIII', 'Recorrido', '#recorrido'],
];

const tour = [
  ['Inicio', '/', 'Films, historia, góndola de destacados y los dos mundos: té y café.'],
  ['Té y herboristería', '/te/', `${tes.length} productos reales con filtros por línea y búsqueda.`],
  ['Café', '/cafe/', `${cafes.length} productos: tostado, torrado, granos, cápsulas y más.`],
  ['Ficha de producto', '/productos/te-negro-clasico/', 'Ficha sensorial, presentaciones y transición desde la tarjeta.'],
  ['Pedido mayorista', '/pedido/', 'El carrito convertido en solicitud B2B con CUIT y provincia.'],
  ['Nuestra historia', '/empresa/', 'De Rosario 1915 a 18 países, calidad FSSC 22000 y la planta.'],
  ['Para empresas', '/empresas/', 'La Virginia Espresso, comercio exterior y alta de clientes.'],
  ['Sustentabilidad', '/sustentabilidad/', 'El saquito compostable contado paso a paso.'],
  ['Conocé tu café', '/conoce-tu-cafe/', 'Guía: torrado vs. tostado, azúcar, formatos y origen.'],
  ['Página 404', '/esta-pagina-no-existe/', 'Hasta el error tiene su taza.'],
];

const filmKB = Math.round(fs.statSync('public/media/te-hero-v.mp4').size / 1024);
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const mail = `mailto:${AUTHOR.email}?subject=${encodeURIComponent('Rediseño web La Virginia')}`;
---
<Base
  title="Propuesta de rediseño"
  description="Propuesta de rediseño conceptual para la marca de té y café La Virginia: antes y después, métricas medidas, decisiones de diseño e implementación."
>
  <!-- ============ PORTADA ============ -->
  <section class="ph t-azul">
    <div class="wrap ph__grid">
      <div class="ph__main">
        <p class="label">Propuesta · Rediseño N.º 02</p>
        <Lines as="h1" class="d1 ph__title" text="Un siglo de sabor.|_Una web a su altura._" />
        <p class="lede" data-rv style="--d:250">Propuesta de rediseño conceptual para la marca de té y café de Cafés La Virginia S.A.: más rápida, más clara para quien compra en el súper y con un camino propio para comercios y distribuidores.</p>
        <div class="ph__cta" data-rv style="--d:350">
          <a class="btn btn--oro" href={url('/')}>Recorrer el sitio <Icon name="arrow" /></a>
          <a class="btn btn--line" href="#contacto">Hablemos</a>
        </div>
      </div>
      <nav class="toc" aria-label="Índice de la propuesta" data-rv style="--d:200">
        <p class="toc__h">Índice</p>
        <ol>
          {chapters.map(([n, t, h]) => (
            <li><a href={h}><span class="roman">{n}</span><span class="toc__t">{t}</span><span class="toc__dots" aria-hidden="true"></span><Icon name="arrow" size={16} /></a></li>
          ))}
        </ol>
      </nav>
    </div>
    <div class="wrap">
      <dl class="ph__meta" data-rv style="--d:450">
        <div><dt>Cliente</dt><dd>Cafés La Virginia S.A.</dd></div>
        <div><dt>Alcance</dt><dd>Marca de té y café</dd></div>
        <div><dt>Catálogo</dt><dd>{products.length} productos reales</dd></div>
        <div><dt>Autor</dt><dd>{AUTHOR.name}</dd></div>
        <div><dt>Fecha</dt><dd>{measured}</dd></div>
      </dl>
    </div>
  </section>

  <!-- ============ I · CARTA ============ -->
  <section id="carta" class="sec letter">
    <div class="wrap letter__in">
      <Seal class="letter__seal" />
      <div>
        <p class="roman">I · Carta</p>
        <p class="letter__hi serif" data-rv>Estimado equipo de La Virginia:</p>
        <div class="letter__body serif" data-rv style="--d:120">
          <p>Hace más de cien años que sus productos están en la mesa argentina. Este concepto propone cómo podría verse su casa digital: el mismo carácter de siempre —el azul, el oro, el sol del logotipo— con la velocidad, el orden y las herramientas comerciales que hoy esperan un consumidor y un distribuidor.</p>
          <p>No reemplaza lo que funciona: el catálogo se sigue administrando en la tienda actual y se sincroniza solo. Lo que cambia es la experiencia.</p>
        </div>
        <p class="letter__sign" data-rv style="--d:220"><span class="serif">{AUTHOR.name}</span> · Diseño y desarrollo web</p>
      </div>
    </div>
  </section>

  <!-- ============ II · ANTES Y DESPUÉS ============ -->
  <section id="antes-despues" class="sec t-noche ba">
    <div class="wrap">
      <div class="shead">
        <div>
          <p class="roman">II</p>
          <Lines class="d2" text="Antes _y después._" />
        </div>
        <p class="lede" data-rv>Arrastrá el control para comparar el sitio actual con el rediseño, en la misma pantalla y con la misma página.</p>
      </div>
      <div data-tabs>
        <div class="seg" role="group" aria-label="Página a comparar" data-rv>
          <button type="button" data-tab="ba-home" aria-pressed="true">Inicio</button>
          <button type="button" data-tab="ba-pdp" aria-pressed="false">Ficha de producto</button>
        </div>
        {[
          { id: 'ba-home', o: 'old-home', n: 'new-home', om: 'old-m', nm: 'new-m', what: 'la página de inicio' },
          { id: 'ba-pdp', o: 'old-pdp', n: 'new-pdp', om: 'old-pdp-m', nm: 'new-pdp-m', what: 'la ficha de Té Negro Clásico' },
        ].map((c, i) => (
          <div class="cmp" data-cmp data-panel={c.id} hidden={i > 0} data-rv>
            <picture><source media="(max-width: 640px)" srcset={url(`/pitch/${c.om}.avif`)} width="560" height="953" /><img class="cmp__old" src={url(`/pitch/${c.o}.avif`)} srcset={`${url(`/pitch/${c.o}-sm.avif`)} 900w, ${url(`/pitch/${c.o}.avif`)} 1600w`} sizes="(min-width: 1520px) 1400px, 92vw" alt={`Sitio actual: ${c.what}`} width="1600" height="1000" loading="lazy" decoding="async" /></picture>
            <div class="cmp__new"><picture><source media="(max-width: 640px)" srcset={url(`/pitch/${c.nm}.avif`)} width="560" height="953" /><img src={url(`/pitch/${c.n}.avif`)} srcset={`${url(`/pitch/${c.n}-sm.avif`)} 900w, ${url(`/pitch/${c.n}.avif`)} 1600w`} sizes="(min-width: 1520px) 1400px, 92vw" alt={`Rediseño: ${c.what}`} width="1600" height="1000" loading="lazy" decoding="async" /></picture></div>
            <div class="cmp__bar" aria-hidden="true"><span class="cmp__tag cmp__tag--l">Actual</span><span class="cmp__tag cmp__tag--r">Rediseño</span><span class="cmp__knob"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5" /></svg></span></div>
            <input class="cmp__range" type="range" min="0" max="100" value="50" step="0.5" aria-label={`Comparar ${c.what}: sitio actual a la izquierda, rediseño a la derecha`} />
          </div>
        ))}
      </div>
      <p class="ba__note">Capturas del {measured}: escritorio a 1440 × 900 px y celular a 390 × 664 px. El sitio actual pertenece a Cafés La Virginia S.A.</p>
    </div>
  </section>

  <!-- ============ III · DÓNDE HAY MARGEN ============ -->
  <section id="margen" class="sec wrap">
    <div class="shead">
      <div>
        <p class="roman">III</p>
        <Lines class="d2" text="Lo que funciona se queda.|_Esto es lo que suma._" />
      </div>
      <p class="lede" data-rv>La marca, el catálogo y la tienda actual son una gran base. Estas son las oportunidades que encontré y cómo las resuelve el rediseño.</p>
    </div>
    <ol class="gaps">
      <li data-rv>
        <span class="gaps__n roman">I</span>
        <h3>Velocidad en el celular</h3>
        <p>Hoy el contenido principal tarda unos {fmt(round(M.home.old.lcp / 1000, 1), 1)} s en aparecer en un celular con 4G. El rediseño lo muestra {speedup} veces antes, con {fmt(Math.round(M.home.new.js / 1000))} KB de JavaScript.</p>
      </li>
      <li data-rv style="--d:90">
        <span class="gaps__n roman">II</span>
        <h3>Un camino para comercios</h3>
        <p>Sin precios en línea, un almacén o una cafetería no tiene un paso claro para comprar. El carrito se convierte en una solicitud mayorista que llega lista al equipo comercial.</p>
      </li>
      <li data-rv style="--d:180">
        <span class="gaps__n roman">III</span>
        <h3>Catálogo con contexto</h3>
        <p>Cada producto suma su ficha sensorial —color, sabor, aroma, intensidad—, presentaciones y filtros por línea. Todo sale de los datos que ya publica la marca.</p>
      </li>
      <li data-rv style="--d:270">
        <span class="gaps__n roman">IV</span>
        <h3>Accesible para todos</h3>
        <p>Contraste de textos, orden de títulos, tamaño de los botones al tocar y textos alternativos. La ficha de producto pasa de {M.pdp.old.a11y} a {M.pdp.new.a11y} en accesibilidad.</p>
      </li>
    </ol>
  </section>

  <!-- ============ IV · LOS NÚMEROS ============ -->
  <section id="numeros" class="sec t-crema nums">
    <div class="wrap">
      <div class="shead">
        <div>
          <p class="roman">IV</p>
          <Lines class="d2" text="Medido, _no prometido._" />
        </div>
        <p class="lede" data-rv>Misma herramienta, mismas condiciones: {M.tool}. Cada cifra cuenta desde el valor del sitio actual hasta el del rediseño.</p>
      </div>

      <div class="rings">
        {pages.map((p, i) => (
          <figure class="ring" data-rv style={`--d:${i * 120};--off:${100 - p.n.perf};--offo:${100 - p.o.perf}`}>
            <div class="ring__g">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle class="ring__t" cx="60" cy="60" r="52" pathLength="100" />
                <circle class="ring__v" cx="60" cy="60" r="52" pathLength="100" />
                <circle class="ring__to" cx="60" cy="60" r="40" pathLength="100" />
                <circle class="ring__o" cx="60" cy="60" r="40" pathLength="100" />
              </svg>
              <p class="ring__c"><span class="ring__n" data-from={p.o.perf} data-count={p.n.perf}>{p.n.perf}</span><small>de 100</small></p>
            </div>
            <figcaption>
              <strong>{p.label}</strong>
              <span>Rendimiento móvil · actual {p.o.perf}, rediseño {p.n.perf}</span>
            </figcaption>
          </figure>
        ))}
        <div class="rings__legend" data-rv style="--d:240">
          <p class="key"><i class="key__n"></i>Rediseño</p>
          <p class="key"><i class="key__o"></i>Sitio actual</p>
          <p class="rings__big"><span class="ring__x">×{speedup}</span> más rápido en mostrar el contenido principal del inicio.</p>
        </div>
      </div>

      <div data-tabs class="ledger-wrap">
        <div class="ledger-top">
          <div class="seg seg--light" role="group" aria-label="Página medida">
            {pages.map((p, i) => <button type="button" data-tab={`m-${p.id}`} aria-pressed={i === 0 ? 'true' : 'false'}>{p.label}</button>)}
          </div>
          <div class="ledger-key" aria-hidden="true"><span class="key"><i class="key__o"></i>Sitio actual</span><span class="key"><i class="key__n"></i>Rediseño</span></div>
        </div>
        {pages.map((p, i) => (
          <table class="ledger" data-panel={`m-${p.id}`} hidden={i > 0}>
            <caption class="sr-only">{p.label}: sitio actual comparado con el rediseño</caption>
            <thead><tr><th scope="col">Métrica</th><th scope="col">Sitio actual y rediseño</th><th scope="col">Cambio</th></tr></thead>
            <tbody>
              {p.rows.map((r, j) => {
                const max = r.max ?? Math.max(r.old, r.neu);
                return (
                  <tr data-rv style={`--d:${j * 60}`}>
                    <th scope="row">{r.k}<small>{r.hint}</small></th>
                    <td class="ledger__bars">
                      <div class="b b--o"><i style={`--w:${((r.old / max) * 100).toFixed(1)}`}></i><span><span class="sr-only">Actual: </span>{fmt(round(r.old, r.dec), r.dec)}{r.unit}</span></div>
                      <div class="b b--n"><i style={`--w:${((r.neu / max) * 100).toFixed(1)}`}></i><span><span class="sr-only">Rediseño: </span><span data-from={round(r.old, r.dec)} data-count={round(r.neu, r.dec)} data-dec={r.dec}>{fmt(round(r.neu, r.dec), r.dec)}</span>{r.unit}</span></div>
                    </td>
                    <td class="ledger__d">{change(r)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        ))}
        <p class="ledger__note">Medición del {measured} con Lighthouse 12 sobre el sitio publicado, perfil móvil (Moto G Power, 4G lenta simulada). El rediseño tiene la indexación desactivada a propósito por ser un concepto, por eso no se compara SEO.</p>
      </div>
    </div>
  </section>

  <!-- ============ V · IDEAS DE DISEÑO ============ -->
  <section id="ideas" class="sec wrap">
    <div class="shead">
      <div>
        <p class="roman">V</p>
        <Lines class="d2" text="Clásico de nacimiento,|_moderno por elección._" />
      </div>
      <p class="lede" data-rv>Nada de lo visual es decorativo: cada decisión sale de la historia de la marca o de cómo compra su cliente.</p>
    </div>
    <div class="ideas">
      <article class="idea idea--wide" data-rv>
        <div class="idea__vis idea__vis--azul">
          <div class="sw">
            {[['#0a2e73', 'Azul Virginia'], ['#061a40', 'Noche'], ['#ffd302', 'Oro del logo'], ['#a8822d', 'Latón'], ['#f4eee2', 'Crema'], ['#fbf8f2', 'Porcelana']].map(([c, n]) => (
              <span style={`--c:${c}`}><i></i><b>{n}</b><code>{c}</code></span>
            ))}
          </div>
        </div>
        <p class="roman">I</p>
        <h3>El azul que se funde</h3>
        <p>Los films se generaron sobre el mismo azul de la marca, así el video no tiene bordes: se derrite en la página. El oro del logotipo queda reservado para lo que importa: acciones y énfasis.</p>
      </article>
      <article class="idea" data-rv style="--d:90">
        <div class="idea__vis"><div class="archs"><span></span><span></span><span></span></div></div>
        <p class="roman">II</p>
        <h3>El arco</h3>
        <p>La ventana de las fachadas clásicas de Rosario enmarca fotos, packshots y videos. Un solo gesto que se reconoce en todo el sitio.</p>
      </article>
      <article class="idea" data-rv style="--d:180">
        <div class="idea__vis idea__vis--type"><span class="ty1">Aa</span><span class="ty2">Aa</span></div>
        <p class="roman">III</p>
        <h3>Tipografía con historia</h3>
        <p>Fraunces, una serif de eje óptico con aire de etiqueta de 1915, junto a Hanken Grotesk para leer con claridad en pantallas chicas.</p>
      </article>
      <article class="idea" data-rv>
        <div class="idea__vis idea__vis--meter">
          <p>Intensidad</p>
          <div class="mt">{[1, 1, 1, 1, 0].map((on) => <span class:list={{ on }}><Icon name="leaf" size={22} /></span>)}</div>
        </div>
        <p class="roman">IV</p>
        <h3>Ficha sensorial</h3>
        <p>Color, sabor, aroma e intensidad, tomados de los datos oficiales y presentados para comparar de un vistazo.</p>
      </article>
      <article class="idea" data-rv style="--d:90">
        <div class="idea__vis idea__vis--b2b">
          <div class="tk"><Icon name="box" size={20} /><span>Solicitud #LV-20431</span></div>
          <div class="tk tk--2"><span>CUIT · Rubro · Provincia</span></div>
        </div>
        <p class="roman">V</p>
        <h3>Pedido mayorista</h3>
        <p>El sitio no vende al público, así que el carrito pide lo que un distribuidor necesita: razón social, CUIT, rubro y provincia.</p>
      </article>
      <article class="idea" data-rv style="--d:180">
        <div class="idea__vis idea__vis--vt"><span class="vt1"></span><span class="vt2"></span></div>
        <p class="roman">VI</p>
        <h3>Transiciones nativas</h3>
        <p>La tarjeta del producto se transforma en su ficha con la API de View Transitions del navegador. Sin librerías pesadas.</p>
      </article>
      <article class="idea" data-rv>
        <div class="idea__vis idea__vis--film">
          <div class="film arch"><video data-lazy muted loop playsinline preload="none" poster={url('/media/te-hero-sm.avif')} width="400" height="500" aria-hidden="true"><source data-src={url('/media/te-hero-v.mp4')} type="video/mp4" /></video></div>
          <span class="film__kb">Este film: {filmKB} KB</span>
        </div>
        <p class="roman">VII</p>
        <h3>Films que no pesan</h3>
        <p>Cinco films generados con IA sobre la estética de la marca, comprimidos y cargados solo cuando aparecen en pantalla.</p>
      </article>
    </div>
  </section>

  <!-- ============ VI · EN EL CELULAR ============ -->
  <section id="movil" class="sec t-azul mob">
    <div class="wrap mob__grid">
      <div>
        <p class="roman">VI</p>
        <Lines class="d2" text="Pensado primero|_para el celular._" />
        <p class="lede" data-rv style="margin-top:22px">La mayoría de las visitas llega desde un teléfono. El rediseño pone el producto y la acción en la primera pantalla, con botones cómodos para el pulgar.</p>
        <div class="qr" data-rv style="--d:150">
          <div class="qr__code" set:html={qr} role="img" aria-label={`Código QR que abre ${siteUrl}`}></div>
          <div>
            <p class="qr__t serif">Probalo en tu celular</p>
            <p class="qr__u">{siteUrl.replace(/^https:\/\//, '')}</p>
          </div>
        </div>
      </div>
      <div class="phones">
        <figure class="phone phone--old" data-rv>
          <div class="phone__f"><img src={url('/pitch/old-m.avif')} alt="Sitio actual en un iPhone 13" width="560" height="953" loading="lazy" decoding="async" /></div>
          <figcaption>Actual</figcaption>
        </figure>
        <figure class="phone phone--new" data-rv style="--d:150">
          <div class="phone__f"><img src={url('/pitch/new-m.avif')} alt="Rediseño en un iPhone 13" width="560" height="953" loading="lazy" decoding="async" /></div>
          <figcaption>Rediseño</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ VII · INTEGRACIÓN ============ -->
  <section id="integracion" class="sec wrap">
    <div class="shead">
      <div>
        <p class="roman">VII</p>
        <Lines class="d2" text="Sin migrar la tienda.|_Sin rehacer el catálogo._" />
      </div>
      <p class="lede" data-rv>El equipo sigue cargando productos donde ya lo hace. El sitio nuevo lee esos datos, los optimiza y se publica en una red global.</p>
    </div>
    <ol class="flow" aria-label="Flujo de datos">
      {[
        ['factory', 'Tienda actual', 'WooCommerce sigue siendo la fuente: productos, fichas y fotos.'],
        ['recycle', 'Sincronización', 'Un script trae el catálogo y optimiza las imágenes a WebP.'],
        ['globe', 'Sitio estático', 'Páginas prearmadas servidas desde CDN: rápidas y seguras.'],
